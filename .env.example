# Required private single-owner application settings. Generate the password
# hash from a passphrase of at least 16 UTF-8 bytes with
# `npm run auth:hash-password`, and create the independent session secret with
# `openssl rand -hex 32`. Never use NEXT_PUBLIC_ variants.
PROOFCANVAS_APP_ORIGIN=http://127.0.0.1:3000
PROOFCANVAS_OWNER_PASSWORD_HASH=
PROOFCANVAS_SESSION_SECRET=
PROOFCANVAS_DATA_DIR=.proofcanvas-data

# Optional structured AI editing. Both values are server-only and must be set
# together. Without them, the editor uses its visibly labelled deterministic demo.
OPENAI_API_KEY=
PROOFCANVAS_OPENAI_MODEL=

# Optional isolated render sidecar. The URL must be an HTTP(S) root origin with
# no credentials, query, or fragment. Use the same 32-256 character token in
# the Next.js server and sidecar; never expose a NEXT_PUBLIC variant.
PROOFCANVAS_RENDER_URL=
PROOFCANVAS_RENDER_TOKEN=

# Optional sidecar-only private ephemeral job root.
PROOFCANVAS_RENDER_ROOT=

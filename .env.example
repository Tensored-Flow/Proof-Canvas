# ProofCanvas never accepts a plaintext owner password in configuration. Pipe
# one private 16-256 byte passphrase to `npm run auth:hash-password` and paste
# only its scrypt output below. Generate a separate session secret with
# `openssl rand -hex 32`. Never use NEXT_PUBLIC_ variants.
#
# Local development uses this exact HTTP origin. Production and compose must
# replace it with the exact public HTTPS origin, without a trailing slash.
PROOFCANVAS_APP_ORIGIN=http://127.0.0.1:3000
PROOFCANVAS_OWNER_PASSWORD_HASH=
PROOFCANVAS_SESSION_SECRET=

# Local development defaults to .proofcanvas-data when this is omitted, but an
# explicit durable directory is required in production. compose.yaml overrides
# this with /var/lib/proofcanvas on its named volume.
PROOFCANVAS_DATA_DIR=.proofcanvas-data
NEXT_TELEMETRY_DISABLED=1

# Optional structured AI editing. Set both server-only values or neither.
# Without them, the UI visibly labels its narrow deterministic demo mode.
OPENAI_API_KEY=
PROOFCANVAS_OPENAI_MODEL=

# Optional for a host-run development server; required by the V1 compose
# topology. The URL must be one HTTP(S) root origin without credentials, query,
# or fragment. compose.yaml overrides it with the private service DNS name.
PROOFCANVAS_RENDER_URL=

# Use the same independent 32-256 character token in Next.js and the sidecar.
# `openssl rand -hex 32` is suitable. Do not reuse the session secret.
PROOFCANVAS_RENDER_TOKEN=

# Sidecar-only ephemeral job root. Do not set this on browser-facing code or
# mount it from user-controlled/persistent storage.
PROOFCANVAS_RENDER_ROOT=
